# Optional overrides for docker-compose.yml (copy to .env)

# Image name/tag used for build & pull.
MILVUS_LITE_IMAGE=kennytian/milvus-lite:3.2.2

# Where the gRPC port is published on the host.
# 127.0.0.1 keeps the unauthenticated server off the network.
MILVUS_LITE_BIND_ADDR=127.0.0.1
MILVUS_LITE_HOST_PORT=19530

# Optional authentication (leave all empty = no auth).
# Set EITHER a token, OR a username + password pair (or both; either is accepted).
#   token form:       new MilvusClient({ address, token: MILVUS_LITE_TOKEN })
#   username/password:new MilvusClient({ address, username, password })
MILVUS_LITE_TOKEN=
MILVUS_LITE_USERNAME=
MILVUS_LITE_PASSWORD=
