# Optional overrides for docker-compose.yml (copy to .env)

# Image name/tag used for build & pull.
MILVUS_LITE_IMAGE=kennytian/milvus-lite:3.2.2

# Where the gRPC port is published on the host.
# 127.0.0.1 keeps the unauthenticated server off the network.
MILVUS_LITE_BIND_ADDR=127.0.0.1
MILVUS_LITE_HOST_PORT=19530
